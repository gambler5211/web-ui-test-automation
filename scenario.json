{
  "meta": {
    "name": "login for x",
    "base_url": "https://www.github.com"
  },
  "steps": [
    {
      "action": "open_url",
      "url": "/login"
    },
    {
      "action": "get_dom_distill"
    },
    {
      "action": "get_a11y_tree"
    },
    {
      "action": "type",
      "target": {
        "role": "textbox",
        "name": "username"
      },
      "text": "gambler5211",
      "press_enter": true
    },
    {
      "action": "type",
      "target": {
        "role": "textbox",
        "name": "Password"
      },
      "text": "RBAsuU@1",
      "press_enter": true
    },
    {
      "action": "get_text",
      "target": {
        "text": "Incorrect username or password"
      },
      "save_as": "__seen"
    },
    {
      "action": "assert",
      "predicate": {
        "op": "contains",
        "left": "${__seen}",
        "right": "Incorrect username or password"
      }
    }
  ]
}